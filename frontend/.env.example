# API Configuration
# Local development (backend on your machine):
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# On a physical device, use your computer's LAN IP instead:
# EXPO_PUBLIC_BACKEND_URL=http://192.168.1.XXX:8000

# Same-origin deployment (web build served by the API, e.g. production/preview):
# EXPO_PUBLIC_BACKEND_URL=/api

# Payment mode: demo | stripe (stripe requires backend keys + native SDK)
EXPO_PUBLIC_PAYMENT_MODE=demo

# Features
ENABLE_ANALYTICS=false
ENABLE_PUSH_NOTIFICATIONS=false

# Stripe publishable key (only when payment mode is stripe)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
