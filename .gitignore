# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
coverage/

# Builds
build/
dist/
*.tsbuildinfo

# Environment files — never commit secrets
.env
.env.*
!.env.example
*.token.json*
*credentials.json*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/
.mypy_cache/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/

# Deployment
.vercel

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tgz

# Build caches
.cache/
.metro-cache/
.expo/

# Mobile development
android/
ios/
